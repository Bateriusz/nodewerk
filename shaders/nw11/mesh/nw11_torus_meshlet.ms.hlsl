// NW-11 optional mesh-shader experiment: mesh stage.
//
// This shader consumes the vertex buffer generated by the frozen NW-07
// initialization dispatch (nw06_generate_cs) and reads the segment counts and
// radii from graph-derived root constants.  It does not reconstruct a
// hard-coded torus and cannot drift if the frozen graph parameters change.
// The common fragment stage (nw06_scene_ps) consumes the same interpolants.

#define NW_MAJOR_PER_MESHLET 8u
#define NW_MINOR_PER_MESHLET 8u
#define NW_LOCAL_MAJOR (NW_MAJOR_PER_MESHLET + 1u)
#define NW_LOCAL_MINOR (NW_MINOR_PER_MESHLET + 1u)
#define NW_VERTS_PER_MESHLET (NW_LOCAL_MAJOR * NW_LOCAL_MINOR)
#define NW_CELLS_PER_MESHLET (NW_MAJOR_PER_MESHLET * NW_MINOR_PER_MESHLET)
#define NW_PRIMS_PER_MESHLET (NW_CELLS_PER_MESHLET * 2u)

cbuffer Nw06GraphicsParams : register(b0, space0)
{
    uint Tick;
    float FovDegrees;
    float Aspect;
    float NearPlane;
    float FarPlane;
    float Exposure;
    float BloomIntensity;
    float TwistRadians;
};

// Graph-derived mesh constants.  MajorSegments/MinorSegments and the radii
// come from the frozen nw.mesh.torus node; no literal geometry is embedded.
cbuffer Nw11MeshParams : register(b1, space0)
{
    uint MajorSegments;
    uint MinorSegments;
    float MajorRadius;
    float MinorRadius;
    uint VertexCount;
    uint IndexCount;
    uint InstanceCount;
    uint MeshletsPerInstance;
};

Buffer<uint> NwInstances : register(t1, space0);
Buffer<uint> NwCamera : register(t3, space0);
Buffer<uint> NwVertices : register(t6, space0);
Buffer<uint> NwIndices : register(t7, space0);

struct NwMeshPayload
{
    uint instance_index;
    uint meshlet_index;
};

struct MSOutput
{
    float4 position : SV_Position;
    float3 world_position : TEXCOORD0;
    float3 world_normal : TEXCOORD1;
    float2 uv : TEXCOORD2;
    nointerpolation uint material_index : TEXCOORD3;
    float3 camera_position : TEXCOORD4;
};

groupshared float3 g_positions[NW_VERTS_PER_MESHLET];
groupshared float3 g_normals[NW_VERTS_PER_MESHLET];

uint LoadUInt(uint byte_offset)
{
    return NwInstances.Load(byte_offset / 4u);
}

float LoadFloat(uint byte_offset)
{
    return asfloat(NwInstances.Load(byte_offset / 4u));
}

struct NwVertex
{
    float3 position;
    float3 normal;
    float2 uv;
};

NwVertex LoadGeneratedVertex(uint vertex_index)
{
    NwVertex vertex;
    // NwVertices is a Buffer<uint>, so Load() takes a 32-bit element index.
    // The frozen nw06_generate_cs stage writes a 32-byte vertex record, i.e.
    // eight uint elements per vertex.
    uint offset = vertex_index * 8u;
    float4 first = asfloat(uint4(
        NwVertices.Load(offset + 0u),
        NwVertices.Load(offset + 1u),
        NwVertices.Load(offset + 2u),
        NwVertices.Load(offset + 3u)));
    float4 second = asfloat(uint4(
        NwVertices.Load(offset + 4u),
        NwVertices.Load(offset + 5u),
        NwVertices.Load(offset + 6u),
        NwVertices.Load(offset + 7u)));
    vertex.position = first.xyz;
    vertex.normal = float3(first.w, second.x, second.y);
    vertex.uv = second.zw;
    return vertex;
}

float3 RotateY(float3 value, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return float3(c * value.x - s * value.z, value.y, s * value.x + c * value.z);
}

float4x4 Perspective(float fov_degrees, float aspect, float near_plane, float far_plane)
{
    float f = 1.0 / tan(radians(fov_degrees) * 0.5);
    return float4x4(
        f / aspect, 0.0, 0.0, 0.0,
        0.0, f, 0.0, 0.0,
        0.0, 0.0, far_plane / (far_plane - near_plane), 1.0,
        0.0, 0.0, -near_plane * far_plane / (far_plane - near_plane), 0.0);
}

float4x4 LookAt(float3 eye, float3 target, float3 up)
{
    float3 forward = normalize(target - eye);
    float3 right = normalize(cross(up, forward));
    float3 actual_up = cross(forward, right);
    return float4x4(
        right.x, actual_up.x, forward.x, 0.0,
        right.y, actual_up.y, forward.y, 0.0,
        right.z, actual_up.z, forward.z, 0.0,
        -dot(right, eye), -dot(actual_up, eye), -dot(forward, eye), 1.0);
}

// One group thread owns exactly one vertex of the 9x9 wrapped local patch.
// Launching fewer threads than NW_VERTS_PER_MESHLET would leave mesh output
// vertices unwritten along the patch boundary.
[numthreads(NW_VERTS_PER_MESHLET, 1, 1)]
[outputtopology("triangle")]
void MeshMain(
    uint group_thread_id : SV_GroupThreadID,
    uint group_id : SV_GroupID,
    in payload NwMeshPayload payload,
    out vertices MSOutput vertices[NW_VERTS_PER_MESHLET],
    out indices uint3 triangles[NW_PRIMS_PER_MESHLET])
{
    SetMeshOutputCounts(NW_VERTS_PER_MESHLET, NW_PRIMS_PER_MESHLET);

    uint major_grid = max(1u, MajorSegments / NW_MAJOR_PER_MESHLET);
    uint small_major = payload.meshlet_index % major_grid;
    uint small_minor = payload.meshlet_index / major_grid;
    uint local_row = group_thread_id / NW_LOCAL_MINOR;
    uint local_column = group_thread_id % NW_LOCAL_MINOR;
    uint major = (small_major * NW_MAJOR_PER_MESHLET + local_row) % MajorSegments;
    uint minor = (small_minor * NW_MINOR_PER_MESHLET + local_column) % MinorSegments;
    uint vertex_index = major * MinorSegments + minor;
    NwVertex vertex = LoadGeneratedVertex(min(vertex_index, VertexCount - 1u));

    uint instance_offset = payload.instance_index * 80u;
    uint material_index = LoadUInt(instance_offset + 64u);
    uint loop_ticks = NwCamera.Load(3u);
    uint wrapped_tick = loop_ticks != 0u ? (Tick % loop_ticks) : Tick;
    float phase = loop_ticks != 0u
        ? float(wrapped_tick) * (6.283185307179586 / float(loop_ticks))
        : 0.0;
    float twist = TwistRadians * sin(phase) * vertex.position.y;
    float3 local = RotateY(vertex.position, twist);
    float3 local_normal = RotateY(vertex.normal, twist);

    float4x4 transform = float4x4(
        LoadFloat(instance_offset + 0u), LoadFloat(instance_offset + 4u), LoadFloat(instance_offset + 8u), LoadFloat(instance_offset + 12u),
        LoadFloat(instance_offset + 16u), LoadFloat(instance_offset + 20u), LoadFloat(instance_offset + 24u), LoadFloat(instance_offset + 28u),
        LoadFloat(instance_offset + 32u), LoadFloat(instance_offset + 36u), LoadFloat(instance_offset + 40u), LoadFloat(instance_offset + 44u),
        LoadFloat(instance_offset + 48u), LoadFloat(instance_offset + 52u), LoadFloat(instance_offset + 56u), LoadFloat(instance_offset + 60u));
    float4 world = mul(float4(local, 1.0), transform);
    g_positions[group_thread_id] = world.xyz;
    g_normals[group_thread_id] = normalize(mul(float4(local_normal, 0.0), transform).xyz);

    // The generated per-vertex data is exported through group-shared memory;
    // the barrier makes that lifetime explicit before any vertex output is
    // consumed by the rasterizer.
    GroupMemoryBarrierWithGroupSync();

    float t0 = float(NwCamera.Load(0u));
    float t3 = float(NwCamera.Load(3u));
    float v0 = asfloat(NwCamera.Load(4u));
    float v1 = asfloat(NwCamera.Load(5u));
    float v2 = asfloat(NwCamera.Load(6u));
    float v3 = asfloat(NwCamera.Load(7u));
    float tick = float(wrapped_tick);
    float camera_angle = v0;
    if (tick <= t0) camera_angle = v0;
    else if (tick >= t3) camera_angle = v3;
    else if (tick <= t0 + (t3 - t0) / 3.0) camera_angle = lerp(v0, v1, saturate((tick - t0) / ((t3 - t0) / 3.0)));
    else if (tick <= t0 + 2.0 * (t3 - t0) / 3.0) camera_angle = lerp(v1, v2, saturate((tick - t0 - (t3 - t0) / 3.0) / ((t3 - t0) / 3.0)));
    else camera_angle = lerp(v2, v3, saturate((tick - t0 - 2.0 * (t3 - t0) / 3.0) / ((t3 - t0) / 3.0)));
    float radius = 0.5 * (asfloat(NwCamera.Load(8u)) + asfloat(NwCamera.Load(9u)));
    float3 eye = float3(cos(camera_angle) * radius, asfloat(NwCamera.Load(10u)), sin(camera_angle) * radius);
    float4x4 view = LookAt(eye, float3(0.0, 0.0, 0.0), float3(0.0, 1.0, 0.0));
    float4x4 projection = Perspective(FovDegrees, Aspect, NearPlane, FarPlane);

    vertices[group_thread_id].position = mul(mul(float4(g_positions[group_thread_id], 1.0), view), projection);
    vertices[group_thread_id].world_position = g_positions[group_thread_id];
    vertices[group_thread_id].world_normal = g_normals[group_thread_id];
    // The UV atlas is the generated, graph-derived torus UV.
    vertices[group_thread_id].uv = vertex.uv;
    vertices[group_thread_id].material_index = material_index;
    vertices[group_thread_id].camera_position = eye;

    for (uint cell = group_thread_id; cell < NW_CELLS_PER_MESHLET; cell += NW_VERTS_PER_MESHLET)
    {
        uint row = cell / NW_MINOR_PER_MESHLET;
        uint column = cell % NW_MINOR_PER_MESHLET;
        uint major = (small_major * NW_MAJOR_PER_MESHLET + row) % MajorSegments;
        uint minor = (small_minor * NW_MINOR_PER_MESHLET + column) % MinorSegments;
        uint quad = major * MinorSegments + minor;
        uint local[6];
        [unroll]
        for (uint corner = 0u; corner < 6u; ++corner)
        {
            // Consume the exact generated index buffer instead of deriving an
            // assumed topology.  Each global vertex maps to the 9x9 local
            // patch, including the wrapped torus boundary rows/columns.
            // NwIndices is a Buffer<uint>: the element index is the triangle
            // corner, not a byte offset.
            uint global_index = NwIndices.Load(quad * 6u + corner);
            uint global_major = global_index / MinorSegments;
            uint global_minor = global_index % MinorSegments;
            uint local_major = (global_major + MajorSegments -
                                small_major * NW_MAJOR_PER_MESHLET) % MajorSegments;
            uint local_minor = (global_minor + MinorSegments -
                                small_minor * NW_MINOR_PER_MESHLET) % MinorSegments;
            local[corner] = local_major * NW_LOCAL_MINOR + local_minor;
        }
        // Frozen nw06_generate_cs stores the six indices as
        // (a,c,b),(b,c,d).
        triangles[cell * 2u] = uint3(local[0], local[1], local[2]);
        triangles[cell * 2u + 1u] = uint3(local[3], local[4], local[5]);
    }
}
