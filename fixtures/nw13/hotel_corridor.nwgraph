# NW-13 original hotel-room/corridor production authoring graph.
#
# The graph is backend-neutral and uses the established typed operators.  The
# editable scene, geometry, particles and song are separate public schemas that
# bind to these stable node identities.  No Farbrausch code or asset is used.
nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0
setting nw06_ticks_per_second 48000
setting nw06_output_width 512
setting nw06_output_height 288
setting nw06_frames_in_flight 2
setting nw13_loop_ticks 288000

node wall_texture nw.texture.noise2d@1.0.0 frequency=initialization
  param width 256
  param height 256
  param format r8g8b8a8_unorm
  param seed 31337
  param octaves 4
  param scale 6
  param lacunarity 2
  param gain 0.5

node wall_texture_gpu nw.residency.generate_texture@1.0.0 frequency=initialization residency=gpu
  input texture wall_texture.out

node door_mesh nw.mesh.torus@1.0.0 frequency=initialization
  param major_segments 48
  param minor_segments 24
  param major_radius 0.7
  param minor_radius 0.12

node door_mesh_gpu nw.residency.generate_mesh@1.0.0 frequency=initialization residency=gpu
  input mesh door_mesh.out

node corridor_instances nw.scene.instances@1.0.0 frequency=initialization
  param count 96
  param seed 424242
  param placement_radius 4
  param scale_min 0.08
  param scale_max 0.18
  param twist_radians 0.35

node corridor_scene_gpu nw.residency.generate_instances@1.0.0 frequency=initialization residency=gpu
  input scene corridor_instances.out

node wall_material nw.material.standard@1.0.0 frequency=frame
  input albedo wall_texture_gpu.out
  param base_color 0.52 0.44 0.36 1
  param roughness 0.82
  param metallic 0
  param specular 0.25
  param texture_index 0

node corridor_camera nw.camera.curve@1.0.0 frequency=frame
  param keys "0:0;96000:1.2;192000:2.4;288000:3.6"
  param interpolation linear
  param fov_degrees 58
  param aspect 1.7777777777777777
  param near 0.05
  param far 80
  param radius_min 1.5
  param radius_max 4.5
  param height 1.6
  param curve_value_min 0
  param curve_value_max 3.6
  param curve_quantization_bits 16
  param curve_tolerance 0.0001

node lamp_light nw.light.directional@1.0.0 frequency=frame
  param direction -0.4 -1 -0.3
  param color 1 0.82 0.6

node door_hinge nw.animation.twist@1.0.0 frequency=frame
  param max_twist_degrees 88

node corridor_render nw.render.instanced@1.0.0 frequency=frame residency=gpu
  input mesh door_mesh_gpu.out
  input texture wall_texture_gpu.out
  input scene corridor_scene_gpu.out
  input material wall_material.out
  input camera corridor_camera.out
  input light lamp_light.out
  input animation door_hinge.out

node lamp_bloom nw.post.bloom@1.0.0 frequency=frame residency=gpu
  input image corridor_render.image
  param threshold 0.65
  param intensity 0.4
  param radius 1.5
  param resolution_scale 0.5

node corridor_tonemap nw.post.tonemap@1.0.0 frequency=frame residency=gpu
  input image lamp_bloom.out
  param exposure 1.15
  param gamma 2.2
  param operator aces

node hotel_screen nw.render.present@1.0.0 frequency=frame residency=gpu
  input image corridor_tonemap.out

layout wall_texture 0 0
layout wall_texture_gpu 220 0
layout door_mesh 0 120
layout door_mesh_gpu 220 120
layout corridor_instances 0 240
layout corridor_scene_gpu 220 240
layout wall_material 440 0
layout corridor_camera 440 120
layout lamp_light 440 240
layout door_hinge 440 360
layout corridor_render 660 120
layout lamp_bloom 880 120
layout corridor_tonemap 1100 120
layout hotel_screen 1320 120
