nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy bits
setting quantization_bits 8
setting quantization_tolerance 0.01
setting quantization_fields "gain.value"

# Constant propagation: two, three, sum and doubled fold at compile time.
node two nw.math.scalar_const@1.0.0 frequency=compile-time
  param value 2.0
node three nw.math.scalar_const@1.0.0 frequency=compile-time
  param value 3.0
node sum nw.math.add@1.0.0 frequency=compile-time
  input a two.out
  input b three.out
node duplicated nw.math.add@1.0.0 frequency=compile-time
  input a two.out
  input b three.out
node doubled nw.math.mul@1.0.0 frequency=compile-time
  input a sum.out
  input b two.out

# Field-specific quantizable input that is reachable through the material.
node gain nw.math.scalar_const@1.0.0 frequency=frame
  param value 0.123456789
node roughness nw.control.smoothstep@1.0.0 frequency=frame
  input edge0 two.out
  input edge1 sum.out
  input x gain.out
node color nw.math.vec4_const@1.0.0 frequency=frame
  param value 0.1 0.2 0.3 1.0
node scaled nw.math.vec4_scale@1.0.0 frequency=frame
  input v color.out
  input s doubled.out
node material nw.material.describe@1.0.0 frequency=frame
  input base_color scaled.out
  input roughness roughness.out
  param metallic 0.0
  param specular 0.5

# Dead node/output: unreferenced by any semantic output.
node unused_curve nw.curve.keyframes@1.0.0 frequency=frame
  param keys "0:0;1:1"
  param interpolation linear

node shade nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(uv.x * 0.5, uv.y * 0.5, 0.25, 1.0)"
node texture_recipe nw.texture.procedural@1.0.0 frequency=initialization
  param width 64
  param height 64
  param format r8g8b8a8_unorm
  param seed 3
node texture_gpu nw.residency.upload_texture@1.0.0 frequency=initialization residency=gpu
  input texture texture_recipe.out
node mesh_recipe nw.mesh.recipe@1.0.0 frequency=initialization
  param vertices 4
  param indices 6
node mesh_gpu nw.residency.upload_mesh@1.0.0 frequency=initialization residency=gpu
  input mesh mesh_recipe.out
node scene nw.scene.flat@1.0.0 frequency=frame
  param entries "mesh:0;light:0"
node camera nw.camera.perspective@1.0.0 frequency=frame
  param fov_degrees 60
  param aspect 1.7777778
  param near 0.1
  param far 100
node sun nw.light.directional@1.0.0 frequency=frame
  param direction -0.4 -1.0 -0.3
  param color 1 1 1
node gbuffer nw.render.gbuffer@1.0.0 frequency=frame residency=gpu
  input mesh mesh_gpu.out
  input material material.out
  input camera camera.out
  input light sun.out
  input shader shade.out

# Two structurally identical reachable shader roots exercise node-level CSE.
node shade_a nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(sin(uv.x), cos(uv.y), 0.5, 1.0)"
node shade_b nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(sin(uv.x), cos(uv.y), 0.5, 1.0)"
node fullscreen_a nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader shade_a.out
  input texture texture_gpu.out
node fullscreen_b nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader shade_b.out
  input texture texture_gpu.out

layout two 0 0
layout three 120 0
layout sum 240 0
layout duplicated 360 0
layout doubled 480 0
layout gain 600 0
layout unused_curve 720 0
layout shade 0 120
layout texture_recipe 120 120
layout texture_gpu 240 120
layout gbuffer 360 120
