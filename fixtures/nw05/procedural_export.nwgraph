nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0
setting nw05_output_width 256
setting nw05_output_height 256

# Both terminal roots deliberately contain composition. With no measured
# profitable fusion, NW-05 must execute the dependency DAG as real ordered
# compute dispatches. Equal-sized multi-region UAVs also give the physical
# planner a genuine non-overlapping alias opportunity.
node aux_a nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(uv.y * 0.125, uv.x * 0.125, 0.0, 1.0)"

node aux_b nw.shader.vec4_const@1.0.0 frequency=frame
  param value 0.0 0.0 0.0 0.0

node aux nw.shader.add@1.0.0 frequency=frame
  input a aux_a.out
  input b aux_b.out

node image_a nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(mix(uv.x, sin(uv.y * 17.0 + time), 0.35), mix(uv.y, cos(uv.x * 13.0 - time), 0.25), sin(uv.x * 31.0 + time) * 0.5 + 0.5, 1.0)"

node image_b nw.shader.vec4_const@1.0.0 frequency=frame
  param value 0.0 0.0 0.0 0.0

node image nw.shader.add@1.0.0 frequency=frame
  input a image_a.out
  input b image_b.out

layout aux_a 0 0
layout aux_b 0 100
layout aux 220 50
layout image_a 440 0
layout image_b 440 100
layout image 660 50
