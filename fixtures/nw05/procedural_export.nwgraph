nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0
setting nw05_output_width 256
setting nw05_output_height 256

# Two terminal shader roots are intentional: the first is transient scratch and
# the second is the presented procedural image. This gives the physical planner
# a real non-overlapping UAV alias opportunity without inventing unsupported
# texture/material/render semantics.
node aux nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(uv.y * 0.125, uv.x * 0.125, 0.0, 1.0)"

node image nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(mix(uv.x, sin(uv.y * 17.0 + time), 0.35), mix(uv.y, cos(uv.x * 13.0 - time), 0.25), sin(uv.x * 31.0 + time) * 0.5 + 0.5, 1.0)"

layout aux 0 0
layout image 220 0
