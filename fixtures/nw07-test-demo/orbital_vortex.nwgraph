# NW-07-test-demo branch-only showcase: "Orbital Vortex".
#
# This graph intentionally uses only the post-NW-07 operator/runtime vocabulary.
# It does not change nodewerk semantics.  4096 thin procedural torus instances
# form a dense radial field.  The camera orbits inside that field so nearby
# rings cross the view like an abstract fly-through while the whole scene
# remains stateless and exactly loopable.
nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0
setting nw06_ticks_per_second 48000
setting nw06_output_width 1920
setting nw06_output_height 1080
setting nw06_frames_in_flight 2
setting nw06_frame_step_numerator 800
setting nw06_frame_step_denominator 1
setting nw07_output_width 1920
setting nw07_output_height 1080
setting nw07_loop_ticks 1152000
setting nw07_loop_seconds 24

node texture nw.texture.noise2d@1.0.0 frequency=initialization
  param width 256
  param height 256
  param format r8g8b8a8_unorm
  param seed 2667021917
  param octaves 5
  param scale 18
  param lacunarity 2.2
  param gain 0.55

node texture_gpu nw.residency.generate_texture@1.0.0 frequency=initialization residency=gpu
  input texture texture.out

# A low-poly, very thin torus is intentional: thousands of instances read as
# luminous rings while keeping the indexed-instanced draw inexpensive.
node torus nw.mesh.torus@1.0.0 frequency=initialization
  param major_segments 32
  param minor_segments 8
  param major_radius 1
  param minor_radius 0.055

node mesh_gpu nw.residency.generate_mesh@1.0.0 frequency=initialization residency=gpu
  input mesh torus.out

# The existing generator distributes instances over a radial disk.  Placing the
# camera at radius 5.2 inside a 7.5-unit field creates close passes without any
# new camera or placement operator.
node instances nw.scene.instances@1.0.0 frequency=initialization
  param count 4096
  param seed 3237998146
  param placement_radius 7.5
  param scale_min 0.045
  param scale_max 0.14
  param twist_radians 12.566370614359172

node scene_gpu nw.residency.generate_instances@1.0.0 frequency=initialization residency=gpu
  input scene instances.out

# Cool saturated material + strong directional light deliberately pushes bright
# edges above the bloom threshold, producing an emissive-looking result with the
# existing non-emissive material model.
node material nw.material.standard@1.0.0 frequency=frame
  input albedo texture_gpu.out
  param base_color 0.12 0.32 0.95 1
  param roughness 0.18
  param metallic 0
  param specular 0.95
  param texture_index 0

# Four equally spaced keys produce one constant-speed revolution in exactly
# 24 seconds.  Full-precision curve storage avoids quantization at the seam.
node camera nw.camera.curve@1.0.0 frequency=frame
  param keys "0:0;384000:2.0943951023931953;768000:4.1887902047863905;1152000:6.283185307179586"
  param interpolation linear
  param fov_degrees 78
  param aspect 1.7777777777777777
  param near 0.05
  param far 100
  param radius_min 5.2
  param radius_max 5.2
  param height 0.35
  param curve_value_min 0
  param curve_value_max 6.283185307179586
  param curve_quantization_bits 0
  param curve_tolerance 0.0001

node sun nw.light.directional@1.0.0 frequency=frame
  param direction -0.2 -0.7 0.65
  param color 4 1.8 5.5

# The existing analytic twist is sinusoidal over the loop, so both deformation
# and its value return exactly to the starting state at the boundary.
node twist nw.animation.twist@1.0.0 frequency=frame
  param max_twist_degrees 720

node render nw.render.instanced@1.0.0 frequency=frame residency=gpu
  input mesh mesh_gpu.out
  input texture texture_gpu.out
  input scene scene_gpu.out
  input material material.out
  input camera camera.out
  input light sun.out
  input animation twist.out

node bloom nw.post.bloom@1.0.0 frequency=frame residency=gpu
  input image render.image
  param threshold 0.62
  param intensity 0.9
  param radius 2.2
  param resolution_scale 0.5

node tonemap nw.post.tonemap@1.0.0 frequency=frame residency=gpu
  input image bloom.out
  param exposure 1.25
  param gamma 2.2
  param operator aces

node screen nw.render.present@1.0.0 frequency=frame residency=gpu
  input image tonemap.out

layout texture 0 0
layout texture_gpu 220 0
layout torus 0 120
layout mesh_gpu 220 120
layout instances 0 240
layout scene_gpu 220 240
layout material 440 0
layout camera 440 120
layout sun 440 240
layout twist 440 360
layout render 660 120
layout bloom 880 120
layout tonemap 1100 120
layout screen 1320 120
