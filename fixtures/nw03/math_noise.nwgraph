nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0

# Two identical reachable ShaderExpr roots exercise complete-blob dedup.
node noise_a nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(mix(uv.x, sin(uv.y * 17.0 + time), 0.35), mix(uv.y, cos(uv.x * 13.0 - time), 0.25), sin(uv.x * 31.0 + time) * 0.5 + 0.5, 1.0)"
node noise_b nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(mix(uv.x, sin(uv.y * 17.0 + time), 0.35), mix(uv.y, cos(uv.x * 13.0 - time), 0.25), sin(uv.x * 31.0 + time) * 0.5 + 0.5, 1.0)"

# This shader expression is reachable but intentionally differs from the fused
# roots above, so the fixture has exactly one non-deduplicated specialization.
node noise_alt nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(sin(uv.x * 8.0 + time), cos(uv.y * 9.0 - time), 0.5, 1.0)"

# A shader expression that is not consumed by any GPU pass must not be emitted.
node unused_expr nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(0.25, 0.25, 0.25, 1.0)"

node texture_recipe nw.texture.procedural@1.0.0 frequency=frame
  param width 256
  param height 256
  param format r8g8b8a8_unorm
  param seed 7
node texture_gpu nw.residency.upload_texture@1.0.0 frequency=frame residency=gpu
  input texture texture_recipe.out

node fullscreen_a nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader noise_a.out
  input texture texture_gpu.out
node fullscreen_b nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader noise_b.out
  input texture texture_gpu.out
node fullscreen_c nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader noise_alt.out
  input texture texture_gpu.out

# CPU-side procedural oracle nodes remain authoring/compiler data only and are
# not part of the emitted GPU entry points.
node noise_position nw.math.vec3_const@1.0.0 frequency=frame
  param value 1 2 3
node noise_uv nw.math.vec2_const@1.0.0 frequency=frame
  param value 0.25 0.75
node noise_value nw.proc.value_noise@1.0.0 frequency=frame
  input position noise_position.out
node noise_checker nw.proc.checker@1.0.0 frequency=frame
  input uv noise_uv.out
  input scale noise_value.out

layout noise_a 0 0
layout noise_b 220 0
layout noise_alt 440 0
layout unused_expr 660 0
layout fullscreen_a 0 180
layout fullscreen_b 220 180
layout fullscreen_c 440 180
