nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0
setting nw07_output_width 640
setting nw07_output_height 360

# The ordinary fullscreen shader ABI receives the authored story specialization
# from tools/audio_demo.py at export; the replacement is not a runtime plugin.
node story nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(uv.x, uv.y, frac(time / 48000.0), 1.0)"

node grain nw.texture.procedural@1.0.0 frequency=initialization
  param width 64
  param height 64
  param format r8g8b8a8_unorm
  param seed 48271
node surface nw.residency.upload_texture@1.0.0 frequency=initialization residency=gpu
  input texture grain.out
node frame nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader story.out
  input texture surface.out
node screen nw.render.present@1.0.0 frequency=frame residency=gpu
  input image frame.image

layout story 0 0
layout grain 0 120
layout surface 200 120
layout frame 400 0
layout screen 620 0
