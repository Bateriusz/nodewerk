# NW-10 restricted 20-second SDF intro.
#
# Deliberately narrower than the canonical NW-07 production:
# - fullscreen SDF sphere/torus composition (no mesh pipeline);
# - seeded procedural material;
# - absolute-tick camera curve;
# - ACES tonemapping in the offline-compiled shader;
# - no audio, external assets, runtime DXC, or hardware ray tracing.
nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0
setting nw07_output_width 1920
setting nw07_output_height 1080
setting nw10_intro_loop_ticks 960000
setting nw10_intro_loop_seconds 20
setting nw10_intro_profile nw10.intro.sdf20.v1

# Seeded procedural material.  The fullscreen SDF shader samples this texture;
# no material image is baked into the package.
node material_recipe nw.texture.procedural@1.0.0 frequency=initialization
  param width 256
  param height 256
  param format r8g8b8a8_unorm
  param seed 1297036693
node material_gpu nw.residency.upload_texture@1.0.0 frequency=initialization residency=gpu
  input texture material_recipe.out

# The expression is the graph-owned image root.  The NW-10 intro export
# supplies the frozen offline SDF shader specialization for this root while
# preserving the package, dispatch, present, and player path.
node image nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(uv.x, uv.y, 0.0, 1.0)"

node screen nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader image.out
  input texture material_gpu.out

node present nw.render.present@1.0.0 frequency=frame residency=gpu
  input image screen.image

layout material_recipe 0 0
layout material_gpu 220 0
layout image 0 140
layout screen 220 140
layout present 440 140
