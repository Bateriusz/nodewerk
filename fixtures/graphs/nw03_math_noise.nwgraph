nwgraph 1
profile nw.common.d3d12.fl12_0.sm6_0.v1 sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a
setting optimization O2
setting deterministic true
setting api d3d12
setting feature_level 12_0
setting shader_model 6_0
setting frequency_policy strict
setting shader_blob_policy stable
setting quantization_policy none
setting quantization_bits 0
setting quantization_step 0

node noise_a nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(mix(uv.x, sin(uv.y * 17.0 + time), 0.35), mix(uv.y, cos(uv.x * 13.0 - time), 0.25), sin(uv.x * 31.0 + time) * 0.5 + 0.5, 1.0)"
node noise_alt nw.shader.expr@1.0.0 frequency=frame
  param expression "vec4(sin(uv.x * 8.0 + time), cos(uv.y * 9.0 - time), 0.5, 1.0)"
node texture_recipe nw.texture.procedural@1.0.0 frequency=frame
  param width 256
  param height 256
  param format r8g8b8a8_unorm
  param seed 7
node texture_gpu nw.residency.upload_texture@1.0.0 frequency=frame residency=gpu
  input texture texture_recipe.out
node fullscreen_a nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader noise_a.out
  input texture texture_gpu.out
node fullscreen_b nw.render.fullscreen@1.0.0 frequency=frame residency=gpu
  input shader noise_alt.out
  input texture texture_gpu.out

layout fullscreen_a 0 0
layout fullscreen_b 220 0
