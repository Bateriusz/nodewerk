{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw10-compact-evidence.schema.json",
  "title": "Nodewerk NW-10 compact export evidence",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "implementation_base",
    "historical_nw07_build_inputs_digest",
    "nw10_build_inputs_digest",
    "evidence_status",
    "physical_certification",
    "reference_capture",
    "preserved_contracts",
    "tiers",
    "compact_target",
    "proof",
    "intro",
    "alternatives",
    "dominant_costs",
    "blockers",
    "decision"
  ],
  "properties": {
    "format": { "const": "nw10-compact-evidence" },
    "version": { "const": 1 },
    "task": { "const": "NW-10" },
    "implementation_base": { "const": "c7a73ce64a15973fc18b384543894e68ee2464e8" },
    "historical_nw07_build_inputs_digest": {
      "const": "sha256:v1:d9ad24057ae7c273ad4c757dafc5d3b54047fcb360b8845a6413136b78c232ab"
    },
    "nw10_build_inputs_digest": { "type": "string", "pattern": "^sha256:v1:[0-9a-f]{64}$" },
    "evidence_status": {
      "enum": ["informational_contract_only", "verified_physical", "failed"]
    },
    "physical_certification": { "type": "string" },
    "reference_capture": { "const": "pending_reference_capture" },
    "preserved_contracts": { "type": "object" },
    "tiers": {
      "type": "object",
      "required": [
        "compact_target_bytes",
        "stretch_bytes",
        "proof_bytes",
        "standard_bytes",
        "larger_configured_budgets_supported"
      ],
      "properties": {
        "compact_target_bytes": { "const": 65536 },
        "stretch_bytes": { "const": 131072 },
        "proof_bytes": { "const": 262144 },
        "standard_bytes": { "const": 1048576 },
        "larger_configured_budgets_supported": { "const": true },
        "compact_target_is_universal_feasibility_claim": { "const": false }
      }
    },
    "compact_target": {
      "type": "object",
      "required": ["bytes", "universal_feasibility_claim", "physical_result", "classification"],
      "properties": {
        "bytes": { "const": 65536 },
        "universal_feasibility_claim": { "const": false },
        "physical_result": { "type": ["integer", "null"] },
        "classification": { "type": "string" }
      }
    },
    "proof": {
      "type": "object",
      "required": ["canonical_graph", "canonical_config", "canonical_artifact", "compact_candidate", "ledgers", "measurements", "decoder_code"],
      "properties": {
        "canonical_graph": { "const": "fixtures/nw07/production_loop.nwgraph" },
        "canonical_config": { "const": "benchmarks/nw07/canonical-production.v1.json" }
      }
    },
    "intro": {
      "type": "object",
      "required": ["profile", "canonical_artifact", "compact_artifact", "ledgers", "decision"]
    },
    "alternatives": {
      "type": "object",
      "required": ["parameter_packing", "delta_references", "layouts", "shader_specialization", "compression", "linker_elimination"]
    },
    "dominant_costs": { "type": "array", "minItems": 1 },
    "blockers": { "type": "array" },
    "decision": {
      "type": "object",
      "required": ["classification", "custom_compressor_started", "universal_64k_claim"],
      "properties": {
        "custom_compressor_started": { "const": false },
        "universal_64k_claim": { "const": false }
      }
    }
  }
}
