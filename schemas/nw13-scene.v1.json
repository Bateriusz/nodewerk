{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw13-scene.v1.json",
  "title": "Nodewerk NW-13 bounded scene composition v1",
  "description": "Shared geometry bound to stable object identities, materials, local lights, rigid parent-child transforms, typed animation tracks, camera shots, cuts and transitions. Solid CSG remains in nw13-geometry-graph.",
  "type": "object",
  "required": [
    "format",
    "version",
    "tick_rate_hz",
    "duration_ticks",
    "bounds",
    "materials",
    "lights",
    "objects",
    "cameras"
  ],
  "properties": {
    "format": { "const": "nw13.scene" },
    "version": { "const": 1 },
    "tick_rate_hz": { "const": 48000 },
    "duration_ticks": { "type": "integer", "minimum": 1, "maximum": 172800000 },
    "bounds": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/vec3" },
        "maximum": { "$ref": "#/$defs/vec3" }
      },
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    },
    "lights": {
      "type": "array",
      "items": { "$ref": "#/$defs/light" }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/object" }
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/camera" }
    },
    "cuts": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 }
    },
    "cues": {
      "type": "array",
      "items": { "$ref": "#/$defs/cue" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "color4": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0 }
    },
    "material": {
      "type": "object",
      "required": ["id", "base_color", "roughness", "metallic", "specular"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "base_color": { "$ref": "#/$defs/color4" },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "specular": { "type": "number", "minimum": 0, "maximum": 1 },
        "emission": { "$ref": "#/$defs/vec3" }
      },
      "additionalProperties": false
    },
    "light": {
      "type": "object",
      "required": ["id", "type", "position", "color", "intensity", "range"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["point", "spot", "directional"] },
        "position": { "$ref": "#/$defs/vec3" },
        "color": { "$ref": "#/$defs/vec3" },
        "intensity": { "type": "number", "minimum": 0 },
        "range": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "required": ["tick", "value"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "value": { "$ref": "#/$defs/vec3" },
        "interpolation": { "enum": ["linear", "step", "smoothstep"] }
      },
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "required": ["channel", "value_type", "keys"],
      "properties": {
        "channel": {
          "enum": [
            "transform.position",
            "transform.rotation",
            "transform.scale"
          ]
        },
        "value_type": { "const": "vec3" },
        "keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/key" }
        }
      },
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "required": ["id", "geometry", "material", "transform"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "geometry": { "type": "string", "minLength": 1 },
        "material": { "type": "string", "minLength": 1 },
        "parent": { "type": ["string", "null"] },
        "transform": {
          "type": "object",
          "required": ["position", "rotation", "scale"],
          "properties": {
            "position": { "$ref": "#/$defs/vec3" },
            "rotation": { "$ref": "#/$defs/vec3" },
            "scale": { "$ref": "#/$defs/vec3" }
          },
          "additionalProperties": false
        },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/track" }
        }
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": ["id", "start_tick", "end_tick", "position", "target", "up", "projection"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start_tick": { "type": "integer", "minimum": 0 },
        "end_tick": { "type": "integer", "minimum": 1 },
        "position": { "$ref": "#/$defs/vec3" },
        "target": { "$ref": "#/$defs/vec3" },
        "up": { "$ref": "#/$defs/vec3" },
        "position_track": { "$ref": "#/$defs/track" },
        "target_track": { "$ref": "#/$defs/track" },
        "transition": { "enum": ["cut", "linear", "smoothstep"] },
        "transition_ticks": { "type": "integer", "minimum": 0 },
        "projection": {
          "type": "object",
          "required": ["fov_degrees", "near", "far", "aspect"],
          "properties": {
            "fov_degrees": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
            "near": { "type": "number", "exclusiveMinimum": 0 },
            "far": { "type": "number", "exclusiveMinimum": 0 },
            "aspect": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": ["id", "shots"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shot" }
        }
      },
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "required": ["id", "tick", "policy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tick": { "type": "integer", "minimum": 0 },
        "policy": { "enum": ["one-shot", "repeating"] },
        "kind": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
