{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw07-production-config.schema.json",
  "title": "Nodewerk NW-07 canonical production configuration",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "implementation_base",
    "profile_id",
    "requirements_digest",
    "graph",
    "graph_sha256",
    "pinned_inputs",
    "build_inputs_digest",
    "loop",
    "resolution",
    "content",
    "quality",
    "artifact_budget",
    "fixed_tick_evaluation",
    "capture",
    "diagnostics",
    "build_configuration",
    "image_tolerances",
    "regression",
    "policy"
  ],
  "properties": {
    "format": { "const": "nw07-canonical-production" },
    "version": { "const": 1 },
    "task": { "const": "NW-07" },
    "implementation_base": { "const": "b7e2d11062d4f7bb123ae97c21839631ffc09b93" },
    "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
    "requirements_digest": {
      "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
    },
    "graph": { "type": "string", "minLength": 1 },
    "graph_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pinned_inputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "build_inputs_digest": { "type": "string", "minLength": 1 },
    "loop": {
      "type": "object",
      "required": ["looping", "duration_seconds", "ticks_per_second", "ticks"],
      "properties": {
        "looping": { "const": true },
        "duration_seconds": { "const": 20 },
        "ticks_per_second": { "const": 48000 },
        "ticks": { "const": 960000 }
      }
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 1920 },
        "height": { "const": 1080 }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "torus_instances",
        "seeded",
        "noise_material",
        "camera",
        "twist",
        "lighting",
        "bloom",
        "tonemapping"
      ],
      "properties": {
        "torus_instances": { "const": 256 },
        "seeded": { "const": true }
      }
    },
    "quality": { "type": "object" },
    "artifact_budget": {
      "type": "object",
      "required": [
        "complete_distribution_bytes_ceiling",
        "stretch_distribution_bytes_ceiling",
        "stretch_is_mandatory_gate",
        "peak_engine_committed_gpu_bytes_ceiling",
        "process_start_to_first_present_ms_ceiling"
      ],
      "properties": {
        "complete_distribution_bytes_ceiling": { "const": 262144 },
        "stretch_distribution_bytes_ceiling": { "const": 131072 },
        "stretch_is_mandatory_gate": { "const": false },
        "peak_engine_committed_gpu_bytes_ceiling": { "const": 536870912 },
        "process_start_to_first_present_ms_ceiling": { "const": 2000.0 }
      }
    },
    "fixed_tick_evaluation": { "type": "object" },
    "capture": { "type": "object" },
    "diagnostics": { "type": "object" },
    "build_configuration": {
      "type": "object",
      "required": [
        "cmake_generator", "build_type", "build_profile",
        "pinned_toolchain_enforcement", "toolchain_file",
        "crt_elimination_experiment", "capture_controls",
        "present_sync_interval", "specialized_build_requires_empty_directory", "codegen"
      ],
      "properties": {
        "cmake_generator": { "const": "Ninja" },
        "build_type": { "const": "MinSizeRel" },
        "build_profile": { "const": "release" },
        "pinned_toolchain_enforcement": { "const": "ON" },
        "toolchain_file": { "const": "cmake/toolchains/msvc-x64.cmake" },
        "crt_elimination_experiment": { "const": "OFF" },
        "capture_controls": { "const": "OFF" },
        "present_sync_interval": { "const": 0 },
        "specialized_build_requires_empty_directory": { "const": true },
        "codegen": { "const": "graph-derived generated player source" }
      },
      "additionalProperties": false
    },
    "image_tolerances": { "type": "object" },
    "regression": { "type": "object" },
    "policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
