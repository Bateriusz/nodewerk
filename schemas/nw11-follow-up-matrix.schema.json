{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw11-follow-up-matrix.schema.json",
  "title": "Nodewerk NW-11 bounded advanced-GPU follow-up matrix",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "implementation_base",
    "prototypes_allowed_in_this_task",
    "policy",
    "features",
    "vendor_optional_costs"
  ],
  "properties": {
    "format": { "const": "nw11-follow-up-matrix" },
    "version": { "const": 1 },
    "task": { "const": "NW-11" },
    "implementation_base": { "const": "dc8edbafc3f5928861f14b0fbb932f7d42e81c8b" },
    "prototypes_allowed_in_this_task": { "const": false },
    "policy": { "type": "string", "minLength": 20 },
    "features": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "feature",
          "content_hypothesis",
          "exact_feature_queries",
          "api_requirements",
          "shader_targets",
          "toolchain_requirements",
          "runtime_requirements",
          "deployment_constraints",
          "licensing_constraints",
          "dependencies",
          "byte_cost",
          "prototypes_in_this_task",
          "follow_up_disposition"
        ],
        "properties": {
          "feature": {
            "enum": [
              "vulkan_1_4",
              "asynchronous_compute",
              "work_graphs",
              "shader_execution_reordering",
              "opacity_micromaps",
              "micromesh_clustered_geometry",
              "tensor_neural_shading"
            ]
          },
          "content_hypothesis": { "type": "string", "minLength": 20 },
          "exact_feature_queries": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "api_requirements": { "type": "string", "minLength": 3 },
          "shader_targets": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "toolchain_requirements": { "type": "string", "minLength": 3 },
          "runtime_requirements": { "type": "string", "minLength": 3 },
          "deployment_constraints": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "licensing_constraints": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "distributed_bytes", "optional", "counted"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "distributed_bytes": { "type": "integer", "minimum": 0 },
                "optional": { "const": true },
                "counted": { "const": true }
              },
              "additionalProperties": false
            }
          },
          "byte_cost": { "$ref": "#/$defs/byte_cost" },
          "prototypes_in_this_task": { "const": false },
          "follow_up_disposition": {
            "enum": [
              "follow_up_issue_required",
              "not_applicable",
              "blocked_by_licensing",
              "blocked_by_dependency"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "vendor_optional_costs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["item", "optional", "counted", "byte_cost", "licensing_note"],
        "properties": {
          "item": {
            "enum": ["dlss", "rtx_kit", "model_weights", "vendor_sdk_components"]
          },
          "optional": { "const": true },
          "counted": { "const": true },
          "byte_cost": { "$ref": "#/$defs/byte_cost" },
          "licensing_note": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "byte_cost": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["measured", "unmeasured_estimate"] },
        "value_bytes": { "type": "integer", "minimum": 0 },
        "estimate_bytes": { "type": "integer", "minimum": 0 },
        "basis": { "type": "string", "minLength": 10 }
      },
      "additionalProperties": false
    }
  }
}
