{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw06-operator-contracts.schema.json",
  "title": "Nodewerk NW-06 typed operator extensions",
  "type": "object",
  "required": ["format", "version", "operators"],
  "properties": {
    "format": { "const": "nw06-operator-contracts" },
    "version": { "const": 1 },
    "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
    "requirements_digest": {
      "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
    },
    "operators": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "required": [
          "operator_id",
          "operator_version",
          "kind",
          "frequencies",
          "inputs",
          "outputs",
          "parameters"
        ],
        "properties": {
          "operator_id": { "type": "string", "pattern": "^nw\\." },
          "operator_version": { "const": "1.0.0" },
          "kind": {
            "enum": ["cpu_control", "pure_shader_expr", "gpu_pass"]
          },
          "frequencies": {
            "type": "array",
            "items": {
              "enum": ["compile-time", "initialization", "frame"]
            }
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["port", "logical_type", "residency"],
              "properties": {
                "port": { "type": "string" },
                "logical_type": { "type": "string" },
                "residency": {
                  "enum": ["logical", "cpu", "gpu", "readback"]
                },
                "dimension": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["port", "logical_type", "residency"],
              "properties": {
                "port": { "type": "string" },
                "logical_type": { "type": "string" },
                "residency": {
                  "enum": ["logical", "cpu", "gpu", "readback"]
                },
                "dimension": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": true
            }
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "required": { "type": "boolean" },
                "minimum": { "type": "number" },
                "maximum": { "type": "number" }
              },
              "additionalProperties": true
            }
          },
          "lowering": { "type": "string" },
          "produces_resource": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
