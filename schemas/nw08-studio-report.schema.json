{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw08-studio-report.schema.json",
  "title": "Nodewerk NW-08 authoring editor report",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "session",
    "preview",
    "size_attribution",
    "gpu_cache_budget_bytes",
    "hardware_evidence"
  ],
  "properties": {
    "format": { "const": "nw08-studio-application" },
    "version": { "const": 1 },
    "task": { "const": "NW-08" },
    "hardware_evidence": { "type": "boolean" },
    "gpu_cache_budget_bytes": { "type": "integer", "minimum": 1 },
    "session": {
      "type": "object",
      "required": [
        "format",
        "version",
        "semantic_digest",
        "semantic_digest_provenance",
        "snapshot_generation",
        "profile_id",
        "requirements_digest",
        "nodes",
        "connections",
        "layout",
        "selection",
        "timeline"
      ],
      "properties": {
        "format": { "const": "nw08-studio-session" },
        "version": { "const": 1 },
        "semantic_digest": { "type": "string", "pattern": "^sha256:v1:[0-9a-f]{64}$" },
        "semantic_digest_provenance": {
          "enum": ["nw02", "python-fallback"]
        },
        "snapshot_generation": { "type": "integer", "minimum": 0 },
        "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
        "requirements_digest": {
          "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
        },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "connections": { "type": "array" },
        "layout": { "type": "object" },
        "selection": { "type": "array", "items": { "type": "string" } },
        "timeline": {
          "type": "object",
          "required": ["tick", "frame_index", "duration_ticks", "tick_rate"]
        }
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "format",
        "version",
        "snapshot_generation",
        "device",
        "gpu_cache",
        "queue"
      ],
      "properties": {
        "format": { "const": "nw08-preview-report" },
        "version": { "const": 1 },
        "snapshot_generation": { "type": "integer", "minimum": 0 },
        "device": {
          "type": "object",
          "required": ["epoch", "lost", "generation_digest"],
          "properties": {
            "epoch": { "type": "integer", "minimum": 0 },
            "lost": { "type": "boolean" },
            "generation_digest": {
              "type": "string",
              "pattern": "^sha256:v1:[0-9a-f]{64}$"
            }
          }
        },
        "gpu_cache": {
          "type": "object",
          "required": [
            "budget_bytes",
            "live_bytes",
            "pending_retirement_bytes",
            "total_bytes",
            "within_budget",
            "stats"
          ],
          "properties": {
            "budget_bytes": { "type": "integer", "minimum": 1 },
            "live_bytes": { "type": "integer", "minimum": 0 },
            "pending_retirement_bytes": { "type": "integer", "minimum": 0 },
            "total_bytes": { "type": "integer", "minimum": 0 },
            "within_budget": { "type": "boolean" }
          }
        },
        "queue": {
          "type": "object",
          "required": ["pending_jobs", "stats"]
        }
      }
    },
    "size_attribution": {
      "type": "object",
      "required": ["format", "version", "available"]
    }
  }
}
