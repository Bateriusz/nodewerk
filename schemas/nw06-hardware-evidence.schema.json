{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw06-hardware-evidence.schema.json",
  "title": "Nodewerk NW-06 fixed-tick procedural scene evidence",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "verification_status",
    "profile_id",
    "requirements_digest",
    "ticks_per_second",
    "qualifications",
    "policy"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "task": { "const": "NW-06" },
    "verification_status": {
      "enum": ["pending_unverified", "execution_recorded", "executed_failure", "verified"]
    },
    "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
    "requirements_digest": {
      "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
    },
    "ticks_per_second": { "const": 48000 },
    "qualifications": {
      "type": "object",
      "required": ["ada", "blackwell"],
      "properties": {
        "ada": { "$ref": "#/$defs/qualification" },
        "blackwell": { "$ref": "#/$defs/qualification" }
      },
      "additionalProperties": false
    },
    "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
    "executions": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
    "unavailable_telemetry": {
      "type": "array",
      "items": { "type": "string" }
    },
    "toolchain_manifest_sha256": { "type": "string" },
    "policy": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "qualification": {
      "type": "object",
      "required": ["coverage_target", "evidence_role", "status"],
      "properties": {
        "coverage_target": { "type": "string" },
        "evidence_role": { "const": "fixed_tick_correctness" },
        "status": {
          "enum": ["pending_unverified", "execution_recorded", "failed", "verified"]
        },
        "reason": { "type": "string" },
        "artifact_key": { "type": "string" },
        "package_sha256": { "type": "string" },
        "executable_sha256": { "type": "string" }
      },
      "additionalProperties": true
    },
    "capture": {
      "type": "object",
      "required": [
        "capture_id",
        "coverage_target",
        "evidence_role",
        "status"
      ],
      "properties": {
        "capture_id": { "type": "string", "minLength": 1 },
        "coverage_target": { "type": "string", "minLength": 1 },
        "evidence_role": { "const": "fixed_tick_correctness" },
        "artifact_key": { "type": "string", "minLength": 1 },
        "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_sha256": { "type": "string", "minLength": 1 },
        "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
        "requirements_digest": {
          "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
        },
        "adapter_description": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "driver_version": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string", "minLength": 1 },
        "toolchain_identity": { "type": "string", "minLength": 1 },
        "queried_capabilities": { "type": "object" },
        "clock_information": { "type": "object" },
        "power_information": { "type": "object" },
        "thermal_information": { "type": "object" },
        "cache_state": { "type": ["object", "string"] },
        "capture_protocol": { "type": "string", "minLength": 1 },
        "fixed_ticks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "capture_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/capture_artifact" }
        },
        "comparison": { "$ref": "#/$defs/comparison" },
        "unavailable_telemetry": {
          "type": "array",
          "items": { "type": "string" }
        },
        "status": { "enum": ["passed", "failed", "pending_unverified"] }
      },
      "additionalProperties": true
    },
    "capture_artifact": {
      "type": "object",
      "required": ["kind", "format", "path", "sha256", "bytes", "tick", "width", "height"],
      "properties": {
        "kind": { "const": "rgba32f_raw" },
        "format": { "const": "rgba32f" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "tick": { "type": "integer", "minimum": 0 },
        "width": { "const": 256 },
        "height": { "const": 256 }
      },
      "additionalProperties": true
    },
    "comparison": {
      "type": "object",
      "required": ["validated", "status", "numeric", "image", "fixed_ticks", "per_tick", "tolerance_check"],
      "properties": {
        "validated": { "const": true },
        "status": { "enum": ["passed", "within_tolerance", "failed"] },
        "numeric": { "$ref": "#/$defs/numeric_comparison_metric" },
        "image": { "$ref": "#/$defs/comparison_metric" },
        "fixed_ticks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "per_tick": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/per_tick_comparison" }
        },
        "tolerance_check": {
          "type": "object",
          "required": ["status", "observed_maximum_error", "declared_tolerance", "ticks"],
          "properties": {
            "status": { "enum": ["passed", "within_tolerance", "failed"] },
            "observed_maximum_error": { "type": ["number", "integer"], "minimum": 0 },
            "declared_tolerance": { "type": ["number", "integer"], "minimum": 0 },
            "ticks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "comparison_metric": {
      "type": "object",
      "required": ["status", "maximum_error", "tolerance", "ticks"],
      "properties": {
        "status": { "enum": ["passed", "within_tolerance", "failed"] },
        "maximum_error": { "type": ["number", "integer"], "minimum": 0 },
        "tolerance": { "type": ["number", "integer"], "minimum": 0 },
        "ticks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "maximum_relative_error": { "type": ["number", "integer"], "minimum": 0 },
        "relative_tolerance": { "type": ["number", "integer"], "minimum": 0 },
        "width": { "const": 256 },
        "height": { "const": 256 }
      },
      "additionalProperties": true
    },
    "per_tick_comparison": {
      "type": "object",
      "required": ["tick", "artifact_sha256", "numeric", "image", "reference"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "numeric": {
          "type": "object",
          "required": ["status", "maximum_error", "tolerance", "maximum_relative_error", "relative_tolerance", "samples"],
          "properties": {
            "status": { "enum": ["passed", "within_tolerance", "failed"] },
            "maximum_error": { "type": ["number", "integer"], "minimum": 0 },
            "tolerance": { "type": ["number", "integer"], "minimum": 0 },
            "maximum_relative_error": { "type": ["number", "integer"], "minimum": 0 },
            "relative_tolerance": { "type": ["number", "integer"], "minimum": 0 },
            "samples": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": true
        },
        "image": {
          "type": "object",
          "required": ["status", "maximum_error", "tolerance", "width", "height", "pixels"],
          "properties": {
            "status": { "enum": ["passed", "within_tolerance", "failed"] },
            "maximum_error": { "type": ["number", "integer"], "minimum": 0 },
            "tolerance": { "type": ["number", "integer"], "minimum": 0 },
            "pixels": { "type": "integer", "minimum": 1 },
            "width": { "const": 256 },
            "height": { "const": 256 }
          },
          "additionalProperties": true
        },
        "reference": { "$ref": "#/$defs/reference_artifact" }
      },
      "additionalProperties": true
    },
    "reference_artifact": {
      "type": "object",
      "required": [
        "kind",
        "format",
        "path",
        "sha256",
        "bytes",
        "tick",
        "width",
        "height",
        "provenance"
      ],
      "properties": {
        "kind": { "const": "rgba32f_raw" },
        "format": { "const": "rgba32f" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "const": 1048576 },
        "tick": { "type": "integer", "minimum": 0 },
        "width": { "const": 256 },
        "height": { "const": 256 },
        "provenance": {
          "type": "object",
          "required": [
            "source_kind",
            "source_capture_id",
            "source_captured_at_utc",
            "source_adapter_description",
            "source_device",
            "source_driver_version",
            "source_os_version",
            "source_capture_protocol",
            "artifact_key",
            "package_sha256",
            "executable_sha256",
            "manifest_sha256",
            "profile_id",
            "requirements_digest",
            "toolchain_identity"
          ],
          "properties": {
            "source_kind": { "const": "independent_execution" },
            "source_capture_id": { "type": "string", "minLength": 1 },
            "source_captured_at_utc": { "type": "string", "minLength": 1 },
            "source_adapter_description": { "type": "string", "minLength": 1 },
            "source_device": { "type": "string", "minLength": 1 },
            "source_driver_version": { "type": "string", "minLength": 1 },
            "source_os_version": { "type": "string", "minLength": 1 },
            "source_capture_protocol": { "const": "nw06-fixed-tick-capture.v1" },
            "artifact_key": { "type": "string", "minLength": 1 },
            "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "executable_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "manifest_sha256": { "type": "string", "minLength": 1 },
            "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
            "requirements_digest": {
              "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
            },
            "toolchain_identity": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "numeric_comparison_metric": {
      "type": "object",
      "required": ["status", "maximum_error", "tolerance", "ticks", "maximum_relative_error", "relative_tolerance"],
      "properties": {
        "status": { "enum": ["passed", "within_tolerance", "failed"] },
        "maximum_error": { "type": ["number", "integer"], "minimum": 0 },
        "tolerance": { "type": ["number", "integer"], "minimum": 0 },
        "ticks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "maximum_relative_error": { "type": ["number", "integer"], "minimum": 0 },
        "relative_tolerance": { "type": ["number", "integer"], "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
