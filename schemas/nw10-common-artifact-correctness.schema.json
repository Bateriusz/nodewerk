{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw10-common-artifact-correctness.schema.json",
  "title": "Nodewerk NW-10 cross-hardware correctness summary",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "status",
    "capture_protocol",
    "common_artifact",
    "ada",
    "blackwell",
    "comparison",
    "privacy",
    "source"
  ],
  "properties": {
    "format": {"const": "nw10-common-artifact-correctness-summary"},
    "version": {"const": 1},
    "task": {"const": "NW-10"},
    "status": {"const": "verified"},
    "capture_protocol": {"const": "nw07-correctness-capture.v1"},
    "common_artifact": {
      "type": "object",
      "required": ["package_sha256"],
      "properties": {
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ada": {
      "type": "object",
      "required": ["status", "hardware"],
      "properties": {
        "status": {"const": "verified"},
        "hardware": {
          "type": "object",
          "required": ["adapter_description", "classified_tier", "device_form_factor"],
          "properties": {
            "adapter_description": {"type": "string", "minLength": 1},
            "classified_tier": {"const": "ada"},
            "device_form_factor": {"const": "desktop"},
            "driver_version": {"type": "string"}
          }
        }
      }
    },
    "blackwell": {
      "type": "object",
      "required": ["status", "hardware"],
      "properties": {
        "status": {"const": "verified"},
        "hardware": {
          "type": "object",
          "required": ["adapter_description", "classified_tier", "device_form_factor"],
          "properties": {
            "adapter_description": {"type": "string", "minLength": 1},
            "classified_tier": {"const": "blackwell"},
            "device_form_factor": {"const": "desktop"},
            "driver_version": {"type": "string"}
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": [
        "fixed_ticks",
        "fixed_tick_status",
        "loop_boundary_ticks",
        "ada_loop_boundary_status",
        "blackwell_loop_boundary_status",
        "worst_absolute_error",
        "worst_relative_error",
        "absolute_tolerance",
        "relative_tolerance",
        "absolute_required"
      ],
      "properties": {
        "fixed_ticks": {
          "type": "array",
          "const": [0, 240000, 480000, 720000, 959999]
        },
        "fixed_tick_status": {"const": "passed"},
        "loop_boundary_ticks": {"type": "array", "const": [0, 960000]},
        "ada_loop_boundary_status": {"const": "passed"},
        "blackwell_loop_boundary_status": {"const": "passed"},
        "worst_absolute_error": {"type": "number", "minimum": 0},
        "worst_relative_error": {"type": "number", "minimum": 0},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "absolute_required": {"const": true}
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "raw_capture_bytes_embedded",
        "local_paths_included",
        "stdout_stderr_included"
      ],
      "properties": {
        "raw_capture_bytes_embedded": {"const": false},
        "local_paths_included": {"const": false},
        "stdout_stderr_included": {"const": false}
      }
    },
    "source": {
      "type": "object",
      "required": [
        "mode",
        "execution_kind",
        "tool",
        "implementation_head",
        "raw_capture_manifests_tracked"
      ],
      "properties": {
        "mode": {"const": "compare"},
        "execution_kind": {"const": "physical_cross_hardware"},
        "tool": {"const": "tools/nw10/run-correctness-evidence.ps1"},
        "implementation_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "raw_capture_manifests_tracked": {"const": false}
      }
    }
  }
}
