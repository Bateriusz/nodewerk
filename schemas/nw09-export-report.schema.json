{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw09-export-report.schema.json",
  "title": "Nodewerk NW-09 stateful export report",
  "type": "object",
  "required": [
    "format",
    "version",
    "stateful",
    "package_version",
    "capability_profile_id",
    "capability_requirements_digest",
    "fixed_step",
    "history",
    "state_resources",
    "frames_in_flight",
    "pending_retirement_bytes",
    "packaged_checkpoints",
    "packaged_checkpoint_byte_cost",
    "present_geometry",
    "portable_gpu_state_replay"
  ],
  "properties": {
    "format": { "const": "nw09-stateful-export-report" },
    "version": { "const": 1 },
    "stateful": { "const": true },
    "package_version": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "const": 1 }
      },
      "additionalProperties": false
    },
    "capability_profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
    "capability_requirements_digest": {
      "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
    },
    "fixed_step": {
      "type": "object",
      "required": [
        "simulation_hz",
        "timeline_ticks_per_second",
        "timeline_ticks_per_simulation_tick"
      ],
      "properties": {
        "simulation_hz": { "const": 120 },
        "timeline_ticks_per_second": { "const": 48000 },
        "timeline_ticks_per_simulation_tick": { "const": 400 }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "operator_id",
          "state_type",
          "initial_value",
          "reset_policy",
          "step_rate_hz",
          "state_layout_hash",
          "current_resource_id",
          "previous_resource_id",
          "ping_pong_distinct",
          "state_bytes",
          "frames_in_flight"
        ],
        "properties": {
          "step_rate_hz": { "const": 120 },
          "reset_policy": { "enum": ["on-loop", "on-seek", "never", "manual"] },
          "ping_pong_distinct": { "const": true }
        },
        "additionalProperties": true
      }
    },
    "state_resources": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "integer", "minimum": 1 }
    },
    "frames_in_flight": { "type": "integer", "minimum": 2, "maximum": 3 },
    "pending_retirement_bytes": { "type": "integer", "minimum": 0 },
    "packaged_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["checkpoint_id", "tick", "byte_cost", "portable_gpu_state_claim"],
        "properties": {
          "byte_cost": { "type": "integer", "minimum": 1 },
          "portable_gpu_state_claim": { "const": false }
        },
        "additionalProperties": true
      }
    },
    "packaged_checkpoint_byte_cost": { "type": "integer", "minimum": 0 },
    "present_geometry": {
      "type": ["object", "null"],
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "portable_gpu_state_replay": { "const": false }
  },
  "additionalProperties": true
}
