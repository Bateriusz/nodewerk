{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw07-metric-baselines.schema.json",
  "title": "Nodewerk NW-07 metric baselines and per-device tolerance definitions",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "profile_id",
    "requirements_digest",
    "absolute_gates",
    "stretch_measurements",
    "image_tolerances",
    "metrics",
    "regression_policy",
    "policy"
  ],
  "properties": {
    "format": { "const": "nw07-metric-baselines" },
    "version": { "const": 1 },
    "task": { "const": "NW-07" },
    "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
    "requirements_digest": {
      "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
    },
    "absolute_gates": {
      "type": "object",
      "required": [
        "complete_distribution_bytes",
        "process_start_to_first_present_ms",
        "peak_engine_committed_gpu_bytes",
        "p99_gpu_frame_time_ms",
        "p99_cpu_submit_ms"
      ]
    },
    "stretch_measurements": { "type": "object" },
    "image_tolerances": {
      "type": "object",
      "required": ["numeric", "image", "per_device", "resolution_requirements"]
    },
    "metrics": { "type": "object" },
    "regression_policy": { "type": "object" },
    "policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
