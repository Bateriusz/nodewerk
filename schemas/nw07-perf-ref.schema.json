{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw07-perf-ref.schema.json",
  "title": "Nodewerk NW-07 nw07_perf_ref_v1 performance reference contract",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "contract_id",
    "contract_status",
    "binding_status",
    "profile_id",
    "requirements_digest",
    "reference",
    "tools",
    "metric_definitions",
    "protocol",
    "matching_rules",
    "change_control",
    "policy"
  ],
  "properties": {
    "format": { "const": "nw07-performance-reference" },
    "version": { "const": 1 },
    "task": { "const": "NW-07" },
    "contract_id": { "const": "nw07_perf_ref_v1" },
    "contract_status": { "const": "frozen" },
    "binding_status": {
      "enum": ["pending_reference_capture", "bound"]
    },
    "profile_id": { "const": "nw.common.d3d12.fl12_0.sm6_0.v1" },
    "requirements_digest": {
      "const": "sha256:v1:d2c53aeaebb76024b3ec89f59814a00e84aaa5131e190a802ede0a956302e17a"
    },
    "reference": {
      "type": "object",
      "required": ["board", "host", "environment", "toolchain", "artifact", "quality", "cache"],
      "properties": {
        "board": {
          "type": "object",
          "required": ["model", "vendor_id", "device_id", "vram_mib"],
          "properties": {
            "model": { "const": "NVIDIA GeForce RTX 4060 Ti" },
            "vendor_id": { "const": 4318 },
            "device_id": { "const": 10245 },
            "vram_mib": { "const": 8192 }
          }
        },
        "host": { "type": "object" },
        "environment": { "type": "object" },
        "toolchain": { "type": "object" },
        "artifact": { "type": "object" },
        "quality": { "type": "object" },
        "cache": { "type": "object" }
      }
    },
    "tools": {
      "type": "object",
      "required": ["percentile_tool", "sample_source", "displayed_frame_interval_source"]
    },
    "metric_definitions": {
      "type": "object",
      "required": ["gpu_frame_time_ms", "cpu_submit_ms", "displayed_frame_interval_ms"],
      "properties": {
        "gpu_frame_time_ms": {
          "type": "object",
          "required": ["definition", "percentile", "percentile_method", "operator", "threshold", "per_run_independent"],
          "properties": {
            "percentile": { "const": 99.0 },
            "percentile_method": { "const": "nearest-rank" },
            "operator": { "const": "<" },
            "threshold": { "const": 16.67 },
            "per_run_independent": { "const": true }
          }
        },
        "cpu_submit_ms": {
          "type": "object",
          "required": ["definition", "percentile", "percentile_method", "operator", "threshold", "per_run_independent"],
          "properties": {
            "percentile": { "const": 99.0 },
            "percentile_method": { "const": "nearest-rank" },
            "operator": { "const": "<" },
            "threshold": { "const": 16.67 },
            "per_run_independent": { "const": true }
          }
        },
        "displayed_frame_interval_ms": {
          "type": "object",
          "required": ["definition", "role", "gate"],
          "properties": {
            "role": { "const": "reported_separately" },
            "gate": { "const": false }
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["protocol_id", "warmup_seconds", "runs", "run_seconds", "uncapped", "fresh_process_per_run", "application_pipeline_cache"],
      "properties": {
        "protocol_id": { "const": "nw07-perf-run.v1" },
        "warmup_seconds": { "const": 5 },
        "runs": { "const": 3 },
        "run_seconds": { "const": 60 },
        "uncapped": { "const": true },
        "fresh_process_per_run": { "const": true },
        "application_pipeline_cache": { "const": false }
      }
    },
    "matching_rules": { "type": "object" },
    "change_control": { "type": "object" },
    "blackwell_development_series": { "type": "object" },
    "policy": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
