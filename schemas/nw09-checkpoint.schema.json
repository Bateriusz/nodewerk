{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw09-checkpoint.schema.json",
  "title": "Nodewerk NW-09 temporal checkpoint",
  "type": "object",
  "required": [
    "format",
    "version",
    "tick",
    "simulation_tick",
    "semantic_digest",
    "state_layout_hash",
    "capability_profile_id",
    "capability_requirements_digest",
    "known_state_layout_hashes",
    "states",
    "event_cursor",
    "loop_generation",
    "residency",
    "portable_gpu_state_claim",
    "byte_cost"
  ],
  "properties": {
    "format": { "const": "nw09-checkpoint" },
    "version": { "const": 2 },
    "tick": { "type": "integer", "minimum": 0, "multipleOf": 400 },
    "simulation_tick": { "type": "integer", "minimum": 0 },
    "semantic_digest": { "type": "string", "pattern": "^sha256:v1:[0-9a-f]{64}$" },
    "state_layout_hash": { "type": "string", "pattern": "^sha256:v1:[0-9a-f]{64}$" },
    "capability_profile_id": { "type": "string", "minLength": 1 },
    "capability_requirements_digest": { "type": "string", "minLength": 1 },
    "known_state_layout_hashes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "operator_id", "state_type", "values"],
        "properties": {
          "node_id": { "type": "string" },
          "operator_id": { "type": "string" },
          "state_type": { "type": "string" },
          "simulation_tick": { "type": "integer", "minimum": 0 },
          "values": {
            "type": "array",
            "items": { "type": "number" }
          }
        },
        "additionalProperties": true
      }
    },
    "event_cursor": {
      "type": "object",
      "required": ["loop_generation", "tick", "sequence"],
      "properties": {
        "loop_generation": { "type": "integer", "minimum": 0 },
        "tick": { "type": "integer", "minimum": -1 },
        "sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "loop_generation": { "type": "integer", "minimum": 0 },
    "device_lifetime": {
      "type": ["object", "null"],
      "required": ["lifetime_id", "epoch"],
      "properties": {
        "lifetime_id": { "type": "string", "minLength": 1 },
        "epoch": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "residency": { "enum": ["host", "device"] },
    "portable_gpu_state_claim": { "const": false },
    "byte_cost": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
