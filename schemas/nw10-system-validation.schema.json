{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nodewerk.invalid/schemas/nw10-system-validation.schema.json",
  "title": "Nodewerk NW-10 physical system validation",
  "type": "object",
  "required": [
    "format",
    "version",
    "task",
    "status",
    "final_artifact",
    "startup",
    "memory",
    "clean_system",
    "windows_build",
    "privacy"
  ],
  "properties": {
    "format": {
      "const": "nw10-system-validation"
    },
    "version": {
      "const": 1
    },
    "task": {
      "const": "NW-10"
    },
    "status": {
      "enum": [
        "verified",
        "verified_reused_split_hosts",
        "pending_unverified"
      ]
    },
    "reason": {
      "type": "string"
    },
    "final_artifact": {
      "type": [
        "object",
        "null"
      ]
    },
    "startup": {
      "type": [
        "object",
        "null"
      ]
    },
    "memory": {
      "type": [
        "object",
        "null"
      ]
    },
    "clean_system": {
      "type": [
        "object",
        "null"
      ]
    },
    "windows_build": {
      "type": [
        "string",
        "null"
      ]
    },
    "privacy": {
      "type": "object",
      "required": [
        "local_paths_included",
        "raw_stdout_stderr_included",
        "user_profile_paths_included",
        "raw_result_bundle_tracked"
      ],
      "properties": {
        "local_paths_included": {
          "const": false
        },
        "raw_stdout_stderr_included": {
          "const": false
        },
        "user_profile_paths_included": {
          "const": false
        },
        "raw_result_bundle_tracked": {
          "const": false
        }
      }
    },
    "measured_artifact": {
      "type": [
        "object",
        "null"
      ]
    },
    "current_artifact": {
      "type": [
        "object",
        "null"
      ]
    },
    "artifact_transfer": {
      "type": [
        "object",
        "null"
      ]
    },
    "environment_consistency": {
      "type": [
        "object",
        "null"
      ]
    },
    "reuse_provenance": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
